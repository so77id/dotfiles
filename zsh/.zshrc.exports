# Editor por defecto
export EDITOR="nvim"
export VISUAL="nvim"

# Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Historial más grande
export HISTSIZE=50000
export SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# Less con colores
export LESS="-R"

# bat usa este theme
export BAT_THEME="Monokai Extended"
